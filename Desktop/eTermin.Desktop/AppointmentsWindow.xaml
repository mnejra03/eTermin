<Window x:Class="eTermin.Desktop.AppointmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Termini"
        Width="1150"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#F8F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- NASLOV -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <StackPanel>

                <TextBlock x:Name="TitleText"
                           Text="Upravljanje terminima"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2F2635"/>

                <TextBlock x:Name="SubtitleText"
                           Text="Pregled i upravljanje terminima."
                           FontSize="14"
                           Foreground="#817784"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </Grid>


        <!-- FILTERI -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>


                <!-- SALON -->
                <ComboBox x:Name="SalonComboBox"
                          Grid.Column="0"
                          Height="40"
                          Padding="8"
                          VerticalContentAlignment="Center"
                          SelectionChanged="SalonComboBox_SelectionChanged"/>


                <!-- DATUM -->
                <DatePicker x:Name="DatePicker"
                            Grid.Column="2"
                            Height="40"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>


                <!-- STATUS -->
                <ComboBox x:Name="StatusComboBox"
                          Grid.Column="4"
                          Height="40"
                          Padding="8"
                          VerticalContentAlignment="Center"
                          SelectionChanged="StatusComboBox_SelectionChanged"/>


                <!-- PRETRAGA -->
                <TextBox x:Name="SearchTextBox"
         Grid.Column="6"
         Height="40"
         Padding="10"
         VerticalContentAlignment="Center"
         ToolTip="Pretraži korisnika, uslugu ili salon..."
         TextChanged="SearchTextBox_TextChanged"/>


                <!-- OSVJEŽI -->
                <Button Grid.Column="7"
                        Content="Osvježi"
                        Width="100"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="#6D4C73"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RefreshButton_Click"/>

            </Grid>

        </Border>


        <!-- TABELA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="15">

            <DataGrid x:Name="AppointmentsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="48">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Korisnik"
                                        Binding="{Binding UserName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Usluga"
                                        Binding="{Binding ServiceName}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Salon"
                                        Binding="{Binding SalonName}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Datum"
                                        Binding="{Binding StartTime, StringFormat=dd.MM.yyyy.}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Vrijeme"
                                        Binding="{Binding StartTime, StringFormat=HH\\:mm}"
                                        Width="90"/>

                    <DataGridTextColumn Header="Cijena"
                                        Binding="{Binding Price, StringFormat={}{0:0.00} KM}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding Status}"
                                        Width="130"/>

                    <DataGridTemplateColumn Header="Akcije"
                        Width="100">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="⋮"
                    Width="35"
                    Height="32"
                    FontSize="18"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="AppointmentActionsButton_Click"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- BROJ TERMINA -->
        <TextBlock x:Name="AppointmentsCountText"
                   Grid.Row="3"
                   Text="Prikazano 0 termina"
                   FontSize="13"
                   Foreground="#817784"
                   Margin="5,12,0,0"/>

    </Grid>

</Window>