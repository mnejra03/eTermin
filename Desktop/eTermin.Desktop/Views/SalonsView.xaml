<UserControl x:Class="eTermin.Desktop.Views.SalonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F4F8">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- NASLOV -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock
                Text="Saloni"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#2D1B36"/>

            <TextBlock
                Text="Upravljanje salonima unutar eTermin sistema."
                FontSize="14"
                Foreground="#777777"
                Margin="0,6,0,0"/>

        </StackPanel>


        <!-- PRETRAGA I AKCIJE -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- PRETRAGA -->

            <Grid Grid.Column="0"
      Width="350"
      HorizontalAlignment="Left">

                <TextBox
        x:Name="SearchTextBox"
        Height="42"
        Padding="14,0"
        VerticalContentAlignment="Center"
        FontSize="14"
        BorderBrush="#E2DCE5"
        BorderThickness="1"
        Background="White"
        TextChanged="SearchTextBox_TextChanged"
        GotFocus="SearchTextBox_GotFocus"
        LostFocus="SearchTextBox_LostFocus"/>

                <TextBlock
        x:Name="SearchPlaceholderText"
        Text="Pretraži salone..."
        Margin="14,0,0,0"
        VerticalAlignment="Center"
        Foreground="#999999"
        FontSize="14"
        IsHitTestVisible="False"/>
            </Grid>


            <!-- DODAJ -->

            <Button
                Grid.Column="1"
                Content="+  Dodaj salon"
                Width="150"
                Height="42"
                Background="#9C27B0"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="AddSalonButton_Click"/>

        </Grid>


        <!-- STATISTIKA SALONA -->
        <Grid Grid.Row="2" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- UKUPNO -->
            <Border
        Grid.Column="0"
        Height="55"
        Margin="0,0,10,0"
        Background="White"
        BorderBrush="#B9A7FF"
        BorderThickness="1"
        CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                Grid.Column="0"
                Text="▦"
                FontSize="22"
                Foreground="#7770FF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                    <TextBlock
                Grid.Column="1"
                Text="Ukupno salona"
                FontSize="13"
                Foreground="#777777"
                VerticalAlignment="Center"/>

                    <TextBlock
                x:Name="TotalSalonsCountText"
                Grid.Column="2"
                Text="0"
                FontSize="16"
                FontWeight="Bold"
                Foreground="#2D1B36"
                VerticalAlignment="Center"
                Margin="0,0,15,0"/>
                </Grid>
            </Border>

            <!-- AKTIVNI -->
            <Border
        Grid.Column="1"
        Height="55"
        Margin="5,0,5,0"
        Background="White"
        BorderBrush="#B9A7FF"
        BorderThickness="1"
        CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                Grid.Column="0"
                Text="●"
                FontSize="20"
                Foreground="#00B85A"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                    <TextBlock
                Grid.Column="1"
                Text="Aktivni"
                FontSize="13"
                Foreground="#777777"
                VerticalAlignment="Center"/>

                    <TextBlock
                x:Name="ActiveSalonsCountText"
                Grid.Column="2"
                Text="0"
                FontSize="16"
                FontWeight="Bold"
                Foreground="#00B85A"
                VerticalAlignment="Center"
                Margin="0,0,15,0"/>
                </Grid>
            </Border>

            <!-- NEAKTIVNI -->
            <Border
        Grid.Column="2"
        Height="55"
        Margin="10,0,0,0"
        Background="White"
        BorderBrush="#B9A7FF"
        BorderThickness="1"
        CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                Grid.Column="0"
                Text="●"
                FontSize="20"
                Foreground="#FF1F1F"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                    <TextBlock
                Grid.Column="1"
                Text="Neaktivni"
                FontSize="13"
                Foreground="#777777"
                VerticalAlignment="Center"/>

                    <TextBlock
                x:Name="InactiveSalonsCountText"
                Grid.Column="2"
                Text="0"
                FontSize="16"
                FontWeight="Bold"
                Foreground="#FF1F1F"
                VerticalAlignment="Center"
                Margin="0,0,15,0"/>
                </Grid>
            </Border>

        </Grid>


        <!-- TABELA -->

        <Border
            Grid.Row="3"
            Background="White"
            CornerRadius="16"
            BorderBrush="#EAE5ED"
            BorderThickness="1"
            Padding="15">

            <DataGrid
                x:Name="SalonsDataGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                Background="White"
                BorderThickness="0"
                RowHeight="55"
                FontSize="13"
                SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Naziv"
                        Binding="{Binding Name}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Grad"
                        Binding="{Binding City}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Adresa"
                        Binding="{Binding Address}"
                        Width="200"/>

                    <DataGridTextColumn
                        Header="Telefon"
                        Binding="{Binding PhoneNumber}"
                        Width="140"/>

                    <DataGridTextColumn
                        Header="Email"
                        Binding="{Binding Email}"
                        Width="200"/>

                    <DataGridCheckBoxColumn
                        Header="Aktivan"
                        Binding="{Binding IsActive}"
                        Width="80"/>

                    <DataGridTemplateColumn Header="Akcije" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                                    <Button
                    Content="Detalji"
                    Width="65"
                    Height="30"
                    Margin="0,0,6,0"
                    Background="#F3E5F5"
                    Foreground="#7B1FA2"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DetailsSalonButton_Click"/>

                                    <Button
                    Content="Uredi"
                    Width="55"
                    Height="30"
                    Margin="0,0,6,0"
                    Background="#EDE7F6"
                    Foreground="#5E35B1"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="EditSalonButton_Click"/>

                                    <Button
                    Content="Obriši"
                    Width="60"
                    Height="30"
                    Background="#FDECEC"
                    Foreground="#C62828"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeleteSalonButton_Click"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- PAGINATION -->
        <Grid Grid.Row="4"
      Margin="0,12,0,0"
      Height="42">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- INFORMACIJA -->
            <TextBlock x:Name="PaginationInfoText"
               Grid.Column="0"
               VerticalAlignment="Center"
               FontSize="12"
               Foreground="#777777"/>

            <!-- PAGINATION -->
            <StackPanel x:Name="PaginationPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</UserControl>