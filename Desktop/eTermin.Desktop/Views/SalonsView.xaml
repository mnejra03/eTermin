<UserControl x:Class="eTermin.Desktop.Views.SalonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F4F8">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- NASLOV -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock
                Text="Saloni"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#2D1B36"/>

            <TextBlock
                Text="Upravljanje salonima unutar eTermin sistema."
                FontSize="14"
                Foreground="#777777"
                Margin="0,6,0,0"/>

        </StackPanel>


        <!-- PRETRAGA I AKCIJE -->

        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- PRETRAGA -->

            <TextBox
                x:Name="SearchTextBox"
                Grid.Column="0"
                Height="42"
                Width="350"
                HorizontalAlignment="Left"
                Padding="14,0"
                VerticalContentAlignment="Center"
                FontSize="14"
                BorderBrush="#E2DCE5"
                BorderThickness="1"
                Background="White"
                TextChanged="SearchTextBox_TextChanged"/>


            <!-- DODAJ -->

            <Button
                Grid.Column="1"
                Content="+  Dodaj salon"
                Width="150"
                Height="42"
                Background="#9C27B0"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="AddSalonButton_Click"/>

        </Grid>


        <!-- STATISTIKA SALONA -->
        <Grid Grid.Row="2" Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- UKUPNO -->
            <Border
        Grid.Column="0"
        Height="55"
        Margin="0,0,10,0"
        Background="White"
        BorderBrush="#B9A7FF"
        BorderThickness="1"
        CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                Grid.Column="0"
                Text="▦"
                FontSize="22"
                Foreground="#7770FF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                    <TextBlock
                Grid.Column="1"
                Text="Ukupno salona"
                FontSize="13"
                Foreground="#777777"
                VerticalAlignment="Center"/>

                    <TextBlock
                x:Name="TotalSalonsCountText"
                Grid.Column="2"
                Text="0"
                FontSize="16"
                FontWeight="Bold"
                Foreground="#2D1B36"
                VerticalAlignment="Center"
                Margin="0,0,15,0"/>
                </Grid>
            </Border>

            <!-- AKTIVNI -->
            <Border
        Grid.Column="1"
        Height="55"
        Margin="5,0,5,0"
        Background="White"
        BorderBrush="#B9A7FF"
        BorderThickness="1"
        CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                Grid.Column="0"
                Text="●"
                FontSize="20"
                Foreground="#00B85A"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                    <TextBlock
                Grid.Column="1"
                Text="Aktivni"
                FontSize="13"
                Foreground="#777777"
                VerticalAlignment="Center"/>

                    <TextBlock
                x:Name="ActiveSalonsCountText"
                Grid.Column="2"
                Text="0"
                FontSize="16"
                FontWeight="Bold"
                Foreground="#00B85A"
                VerticalAlignment="Center"
                Margin="0,0,15,0"/>
                </Grid>
            </Border>

            <!-- NEAKTIVNI -->
            <Border
        Grid.Column="2"
        Height="55"
        Margin="10,0,0,0"
        Background="White"
        BorderBrush="#B9A7FF"
        BorderThickness="1"
        CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                Grid.Column="0"
                Text="●"
                FontSize="20"
                Foreground="#FF1F1F"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

                    <TextBlock
                Grid.Column="1"
                Text="Neaktivni"
                FontSize="13"
                Foreground="#777777"
                VerticalAlignment="Center"/>

                    <TextBlock
                x:Name="InactiveSalonsCountText"
                Grid.Column="2"
                Text="0"
                FontSize="16"
                FontWeight="Bold"
                Foreground="#FF1F1F"
                VerticalAlignment="Center"
                Margin="0,0,15,0"/>
                </Grid>
            </Border>

        </Grid>


        <!-- TABELA -->

        <Border
            Grid.Row="3"
            Background="White"
            CornerRadius="16"
            BorderBrush="#EAE5ED"
            BorderThickness="1"
            Padding="15">

            <DataGrid
                x:Name="SalonsDataGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                Background="White"
                BorderThickness="0"
                RowHeight="55"
                FontSize="13"
                SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Naziv"
                        Binding="{Binding Name}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Grad"
                        Binding="{Binding City}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Adresa"
                        Binding="{Binding Address}"
                        Width="200"/>

                    <DataGridTextColumn
                        Header="Telefon"
                        Binding="{Binding PhoneNumber}"
                        Width="140"/>

                    <DataGridTextColumn
                        Header="Email"
                        Binding="{Binding Email}"
                        Width="200"/>

                    <DataGridCheckBoxColumn
                        Header="Aktivan"
                        Binding="{Binding IsActive}"
                        Width="80"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>