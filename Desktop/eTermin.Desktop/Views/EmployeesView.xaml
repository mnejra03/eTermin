<UserControl x:Class="eTermin.Desktop.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F4F8">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <!-- Gornji dio -->
            <RowDefinition Height="Auto"/>

            <!-- Prostor gdje bi kod Salona bile 3 kartice -->
            <RowDefinition Height="30"/>

            <!-- Tabela -->
            <RowDefinition Height="*"/>

            <!-- Pagination -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- NASLOV + OPIS + FILTERI -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <!-- Naslov -->
            <TextBlock
                Text="Zaposlenici"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#2D1B36"/>

            <!-- Opis -->
            <TextBlock
                Text="Upravljanje zaposlenicima unutar eTermin sistema."
                FontSize="14"
                Foreground="#777777"
                Margin="0,6,0,25"/>


            <!-- FILTERI -->
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="175"/>
                </Grid.ColumnDefinitions>


                <!-- Filter salona -->
                <ComboBox
    x:Name="SalonFilterComboBox"
    Grid.Column="0"
    Height="42"
    Padding="12,0"
    VerticalContentAlignment="Center"
    Background="White"
    BorderBrush="#E2DCE5"
    BorderThickness="1"
    SelectionChanged="SalonFilterComboBox_SelectionChanged"/>


                <!-- Pretraga -->
                <Grid Grid.Column="2"
                      Height="42">

                    <TextBox
                        x:Name="SearchTextBox"
                        Height="42"
                        Padding="32,0,10,0"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        Background="White"
                        BorderBrush="#E2DCE5"
                        BorderThickness="1"
                        TextChanged="SearchTextBox_TextChanged"
                        GotFocus="SearchTextBox_GotFocus"
                        LostFocus="SearchTextBox_LostFocus"/>


                    <TextBlock
                        Text="⌕"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="#999999"
                        IsHitTestVisible="False"/>


                    <TextBlock
                        x:Name="SearchPlaceholderText"
                        Text="Pretraži zaposlenike..."
                        Margin="32,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#999999"
                        FontSize="14"
                        IsHitTestVisible="False"/>

                </Grid>


                <!-- Dodaj zaposlenika -->
                <Button
                    Grid.Column="4"
                    Content="+  Dodaj zaposlenika"
                    Height="42"
                    Background="#9C27B0"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="AddEmployeeButton_Click"/>

            </Grid>

        </StackPanel>


        <!-- ================================================= -->
        <!-- PRAZAN PROSTOR - UMJESTO 3 KARTICE -->
        <!-- ================================================= -->

        <Grid Grid.Row="1">
        </Grid>


        <!-- ================================================= -->
        <!-- TABELA -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="10"
                BorderBrush="#EAE5ED"
                BorderThickness="1">

            <DataGrid
    x:Name="EmployeesDataGrid"
    AutoGenerateColumns="False"
    IsReadOnly="True"
    CanUserAddRows="False"
    CanUserDeleteRows="False"
    HeadersVisibility="Column"
    GridLinesVisibility="Horizontal"
    HorizontalGridLinesBrush="#EAE5ED"
    VerticalGridLinesBrush="#EAE5ED"
    BorderThickness="0"
    RowHeight="48"
    FontSize="13"
    SelectionMode="Single"
    Background="White">

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="White"/>

                        <Setter Property="Foreground"
                                Value="#4A414D"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="FontSize"
                                Value="13"/>

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="Height"
                                Value="42"/>

                        <Setter Property="BorderThickness"
                                Value="0,0,1,1"/>

                        <Setter Property="BorderBrush"
                                Value="#EAE5ED"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>


                    <!-- ========================================= -->
                    <!-- IME I PREZIME -->
                    <!-- ========================================= -->

                    <DataGridTemplateColumn
                    Header="Ime i prezime"
                    Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock
                                Text="{Binding FullName}"
                                VerticalAlignment="Center"
                                Margin="10,0"
                                Foreground="#403741"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ========================================= -->
                    <!-- TELEFON -->
                    <!-- ========================================= -->

                    <DataGridTextColumn
                    Header="Telefon"
                    Binding="{Binding PhoneNumber}"
                    Width="140"/>


                    <!-- ========================================= -->
                    <!-- SALON -->
                    <!-- ========================================= -->

                    <DataGridTextColumn
                    Header="Salon"
                    Binding="{Binding SalonName}"
                    Width="160"/>


                    <!-- ========================================= -->
                    <!-- USLUGE -->
                    <!-- ========================================= -->

                    <DataGridTextColumn
                    Header="Usluge"
                    Binding="{Binding ServicesText}"
                    Width="200"/>


                    <!-- ========================================= -->
                    <!-- RADNO VRIJEME -->
                    <!-- ========================================= -->

                    <DataGridTextColumn
                    Header="Radno vrijeme"
                    Binding="{Binding WorkingHours}"
                    Width="170"/>


                    <!-- ========================================= -->
                    <!-- AKCIJE -->
                    <!-- ========================================= -->

                    <DataGridTemplateColumn Header="Akcije" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>

                                <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                                    <Button
                    Content="Detalji"
                    Width="65"
                    Height="30"
                    Margin="0,0,6,0"
                    Background="#F3E5F5"
                    Foreground="#7B1FA2"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DetailsEmployeeButton_Click"/>

                                    <Button
                    Content="Uredi"
                    Width="55"
                    Height="30"
                    Margin="0,0,6,0"
                    Background="#EDE7F6"
                    Foreground="#5E35B1"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="EditEmployeeButton_Click"/>

                                    <Button
                    Content="Obriši"
                    Width="60"
                    Height="30"
                    Background="#FDECEC"
                    Foreground="#C62828"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="DeleteEmployeeButton_Click"/>

                                </StackPanel>

                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- PAGINATION -->
        <Grid Grid.Row="3"
      Margin="0,12,0,0"
      Height="42">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- INFORMACIJA -->
            <TextBlock
        x:Name="PaginationInfoText"
        Grid.Column="0"
        VerticalAlignment="Center"
        FontSize="12"
        Foreground="#777777"/>

            <!-- PAGINATION DUGMAD -->
            <StackPanel
        x:Name="PaginationPanel"
        Grid.Column="1"
        Orientation="Horizontal"
        VerticalAlignment="Center"/>

        </Grid>

    </Grid>

</UserControl>