<UserControl x:Class="eTermin.Desktop.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F6FA">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- NASLOV STRANICE -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,22">

            <TextBlock Text="Termini"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#3F214F"/>

            <TextBlock Text="Upravljanje terminima i rezervacijama unutar eTermin sistema."
                       FontSize="14"
                       Foreground="#777777"
                       Margin="0,6,0,0"/>

        </StackPanel>


        <!-- PRETRAGA + DODAVANJE -->
        <Grid Grid.Row="1"
              Margin="0,0,0,12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="145"/>
            </Grid.ColumnDefinitions>


            <!-- PRETRAGA -->
            <Border Grid.Column="1"
        Height="40"
        CornerRadius="7"
        Background="White"
        BorderBrush="#E5DFE8"
        BorderThickness="1">

                <Grid>

                    <TextBlock Text="⌕"
                   FontSize="16"
                   Foreground="#9C27B0"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>

                    <TextBox x:Name="SearchTextBox"
                 Margin="32,0,5,0"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="13"
                 VerticalContentAlignment="Center"
                 TextChanged="SearchTextBox_TextChanged"/>

                    <TextBlock x:Name="SearchPlaceholderText"
                   Text="Pretraži termine..."
                   Margin="32,0,5,0"
                   VerticalAlignment="Center"
                   Foreground="#999999"
                   FontSize="12"
                   IsHitTestVisible="False"/>

                </Grid>

            </Border>


            <!-- DODAJ TERMIN -->
            <Button Grid.Column="3"
                    x:Name="AddAppointmentButton"
                    Content="+ Dodaj termin"
                    Height="40"
                    Background="#9C27B0"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="AddAppointmentButton_Click"/>

        </Grid>


        <!-- FILTERI -->
        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- RED SA FILTERIMA -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- DATUM OD - DO -->
                <Border Grid.Column="0"
        Height="40"
        Background="White"
        BorderBrush="#E5DFE8"
        BorderThickness="1"
        CornerRadius="7"
        Margin="0,0,12,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker x:Name="StartDatePicker"
                    Grid.Column="0"
                    Height="38"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="11"
                    VerticalContentAlignment="Center"
                    SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                        <TextBlock Grid.Column="1"
                   Text="→"
                   FontSize="15"
                   Foreground="#777777"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

                        <DatePicker x:Name="EndDatePicker"
                    Grid.Column="2"
                    Height="38"
                    BorderThickness="0"
                    Background="Transparent"
                    FontSize="11"
                    VerticalContentAlignment="Center"
                    SelectedDateChanged="DatePicker_SelectedDateChanged"/>

                    </Grid>

                </Border>


                <!-- SALON -->
                <ComboBox x:Name="SalonFilterComboBox"
                          Grid.Column="1"
                          Height="40"
                          Margin="0,0,12,0"
                          Padding="10,0"
                          FontSize="12"
                          VerticalContentAlignment="Center"
                          SelectionChanged="SalonFilterComboBox_SelectionChanged"/>


                <!-- STATUS -->
                <ComboBox x:Name="StatusFilterComboBox"
                          Grid.Column="2"
                          Height="40"
                          Margin="0,0,12,0"
                          Padding="10,0"
                          FontSize="12"
                          VerticalContentAlignment="Center"
                          SelectionChanged="StatusFilterComboBox_SelectionChanged"/>


                


                <!-- RESET -->
                <Button Grid.Column="3"
        x:Name="ResetButton"
        Content="↻  Resetuj"
        Width="90"
        Height="40"
        HorizontalAlignment="Left"
        Background="White"
        Foreground="#777777"
        BorderBrush="#E5DFE8"
        BorderThickness="1"
        FontSize="12"
        Cursor="Hand"
        Click="ResetButton_Click"/>

            </Grid>


            <!-- TABELA -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="10"
                    BorderBrush="#E5DFE8"
                    BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <DataGrid Grid.Row="0"
                              x:Name="AppointmentsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="White"
                              RowHeight="44"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              SelectionMode="Single"
                              AlternationCount="2">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">

                                <Setter Property="Background"
                                        Value="White"/>

                                <Setter Property="Foreground"
                                        Value="#333333"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                <Setter Property="FontSize"
                                        Value="13"/>

                                <Setter Property="Padding"
                                        Value="8,0"/>

                                <Setter Property="Height"
                                        Value="42"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                            </Style>
                        </DataGrid.ColumnHeaderStyle>


                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">

                                <Setter Property="Background"
                                        Value="White"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                            </Style>
                        </DataGrid.RowStyle>


                        <DataGrid.Columns>

                            <!-- KORISNIK -->
                            <DataGridTextColumn Header="Korisnik"
                                                Binding="{Binding UserName}"
                                                Width="1.2*"/>

                            <!-- USLUGA -->
                            <DataGridTextColumn Header="Usluga"
                                                Binding="{Binding ServiceName}"
                                                Width="1.2*"/>

                            <!-- SALON -->
                            <DataGridTextColumn Header="Salon"
                                                Binding="{Binding SalonName}"
                                                Width="1.2*"/>

                            <!-- DATUM -->
                            <DataGridTextColumn Header="Datum"
                                                Binding="{Binding StartTime, StringFormat={}{0:dd MMM yyyy}}"
                                                Width="1.1*"/>

                            <!-- VRIJEME -->
                            <DataGridTextColumn Header="Vrijeme"
                                                Binding="{Binding StartTime, StringFormat={}{0:HH\\:mm}}"
                                                Width="0.9*"/>


                            <!-- STATUS -->
                            <DataGridTemplateColumn Header="Status"
                                                    Width="1.1*">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <!-- Podrazumijevana boja -->
                                                    <Setter Property="Foreground"
                Value="#6B7280"/>

                                                    <Style.Triggers>

                                                        <!-- NA ČEKANJU -->
                                                        <DataTrigger Binding="{Binding Status}"
                         Value="Pending">

                                                            <Setter Property="Foreground"
                        Value="#F59E0B"/>

                                                        </DataTrigger>

                                                        <!-- POTVRĐENO -->
                                                        <DataTrigger Binding="{Binding Status}"
                         Value="Confirmed">

                                                            <Setter Property="Foreground"
                        Value="#22C55E"/>

                                                        </DataTrigger>

                                                        <!-- ZAVRŠENO -->
                                                        <DataTrigger Binding="{Binding Status}"
                         Value="Completed">

                                                            <Setter Property="Foreground"
                        Value="#3B82F6"/>

                                                        </DataTrigger>

                                                        <!-- OTKAZANO -->
                                                        <DataTrigger Binding="{Binding Status}"
                         Value="Cancelled">

                                                            <Setter Property="Foreground"
                        Value="#EF4444"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>


                            <!-- AKCIJE -->
                            <DataGridTemplateColumn Header="Akcije"
                        Width="70">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="•••"
                    Width="42"
                    Height="30"
                    Background="Transparent"
                    Foreground="#555555"
                    BorderThickness="0"
                    FontSize="15"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="ActionsButton_Click"/>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>


                    <!-- PAGINACIJA -->
                    <Grid Grid.Row="1"
      Margin="0,12,0,0"
      Height="42">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PaginationInfoText"
               Grid.Column="0"
               VerticalAlignment="Center"
               FontSize="12"
               Foreground="#777777"/>

                        <StackPanel x:Name="PaginationPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>