<Window x:Class="eTermin.Desktop.EditAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uredi termin"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F6FA">

    <Border Margin="25"
            Background="White"
            CornerRadius="18"
            Padding="25">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- NASLOV -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,25">

                <TextBlock Text="Uredi termin"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2F2635"/>

                <TextBlock Text="Izmijenite podatke termina"
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="#817784"/>

            </StackPanel>


            <!-- FORMA -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- SALON -->

                    <TextBlock Text="Salon"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="SalonComboBox"
          Height="40"
          Margin="0,0,0,18"
          SelectionChanged="SalonComboBox_SelectionChanged"/>


                    <!-- USLUGA -->

                    <TextBlock Text="Usluga"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="ServiceComboBox"
          Height="40"
          Margin="0,0,0,18"
          SelectionChanged="ServiceComboBox_SelectionChanged"/>


                    <!-- ZAPOSLENIK -->

                    <TextBlock Text="Zaposlenik"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="EmployeeComboBox"
                              Height="40"
                              Margin="0,0,0,18"/>


                    <!-- DATUM -->

                    <TextBlock Text="Datum"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <DatePicker x:Name="DatePicker"
                                Height="40"
                                Margin="0,0,0,18"/>


                    <!-- VRIJEME -->

                    <TextBlock Text="Vrijeme početka"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="StartTimeTextBox"
                             Height="40"
                             Padding="10"
                             ToolTip="Primjer: 10:30"
                             Margin="0,0,0,18"/>


                    <!-- STATUS -->

                    <TextBlock Text="Status"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <ComboBox x:Name="StatusComboBox"
                              Height="40"
                              Margin="0,0,0,18"/>


                    <!-- CIJENA -->

                    <TextBlock Text="Cijena"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="PriceTextBox"
         Height="40"
         Padding="10"
         Margin="0,0,0,18"
         IsReadOnly="True"
         Background="#F3F1F4"/>

                </StackPanel>

            </ScrollViewer>


            <!-- DUGMAD -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Odustani"
                        Width="110"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button Content="Sačuvaj"
                        Width="110"
                        Height="42"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>