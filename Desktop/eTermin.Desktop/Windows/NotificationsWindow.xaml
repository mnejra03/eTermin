<Window x:Class="eTermin.Desktop.Windows.NotificationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Obavijesti"
        Width="500"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F5FA">

    <Border
        Margin="20"
        Padding="25"
        Background="White"
        CornerRadius="20">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- NASLOV -->

            <TextBlock
                Grid.Row="0"
                Text="Obavijesti"
                FontSize="26"
                FontWeight="Bold"
                Foreground="#2D1B36"
                Margin="0,0,0,20"/>

            <!-- LISTA -->

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                <ItemsControl
                    x:Name="NotificationsItemsControl">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
            Margin="0,0,0,10"
            Padding="15"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#EAE5ED"
            Background="#FFFFFF"
            Cursor="Hand"
            MouseLeftButtonUp="NotificationBorder_MouseLeftButtonUp">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- SADRŽAJ OBAVIJESTI -->

                                    <StackPanel Grid.Column="0">

                                        <TextBlock
                        Text="{Binding Title}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#2D1B36"/>

                                        <TextBlock
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        FontSize="14"
                        Foreground="#666666"
                        Margin="0,6,0,6"/>

                                        <TextBlock
                        Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy. HH:mm}}"
                        FontSize="12"
                        Foreground="#999999"/>

                                    </StackPanel>

                                    <!-- DESNA STRANA -->

                                    <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="10,0,0,0">

                                        <!-- NEPROČITANA -->

                                        <Ellipse
                        Width="9"
                        Height="9"
                        Fill="#9C27B0"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0">

                                            <Ellipse.Style>

                                                <Style TargetType="Ellipse">

                                                    <Setter
                                    Property="Visibility"
                                    Value="Collapsed"/>

                                                    <Style.Triggers>

                                                        <DataTrigger
                                        Binding="{Binding IsRead}"
                                        Value="False">

                                                            <Setter
                                            Property="Visibility"
                                            Value="Visible"/>

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Ellipse.Style>

                                        </Ellipse>

                                        <!-- TRASH -->

                                        <Button
                        Content="🗑"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="17"
                        Cursor="Hand"
                        ToolTip="Obriši obavijest"
                        Click="DeleteNotificationButton_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <!-- ZATVORI -->

            <Button
                Grid.Row="2"
                Content="Zatvori"
                Width="110"
                Height="38"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Background="#9C27B0"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click"/>

        </Grid>

    </Border>

</Window>