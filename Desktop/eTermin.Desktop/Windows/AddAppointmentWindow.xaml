<Window x:Class="eTermin.Desktop.Windows.AddAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj termin"
        Width="560"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F6FA">

    <Border Margin="20"
            Background="White"
            CornerRadius="12"
            Padding="28">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- NASLOV -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,24">

                <TextBlock Text="Dodaj termin"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#3F214F"/>

                <TextBlock Text="Kreirajte novi termin i rezervaciju."
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#777777"/>
            </StackPanel>


            <!-- FORMA -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- KORISNIK -->
                    <TextBlock Text="Korisnik"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <ComboBox x:Name="UserComboBox"
                              Height="40"
                              Padding="10,0"
                              FontSize="13"
                              Margin="0,0,0,18"/>


                    <!-- SALON -->
                    <TextBlock Text="Salon"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <ComboBox x:Name="SalonComboBox"
                              Height="40"
                              Padding="10,0"
                              FontSize="13"
                              Margin="0,0,0,18"
                              SelectionChanged="SalonComboBox_SelectionChanged"/>


                    <!-- USLUGA -->
                    <TextBlock Text="Usluga"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <ComboBox x:Name="ServiceComboBox"
                              Height="40"
                              Padding="10,0"
                              FontSize="13"
                              Margin="0,0,0,18"
                              SelectionChanged="ServiceComboBox_SelectionChanged"/>


                    <!-- ZAPOSLENIK -->
                    <TextBlock Text="Zaposlenik"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <ComboBox x:Name="EmployeeComboBox"
                              Height="40"
                              Padding="10,0"
                              FontSize="13"
                              Margin="0,0,0,18"/>


                    <!-- DATUM -->
                    <TextBlock Text="Datum"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <DatePicker x:Name="DatePicker"
                                Height="40"
                                FontSize="13"
                                Margin="0,0,0,18"/>


                    <!-- VRIJEME -->
                    <TextBlock Text="Vrijeme početka"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="StartTimeTextBox"
                             Height="40"
                             Padding="10,0"
                             FontSize="13"
                             Text="09:00"
                             Margin="0,0,0,18"/>


                    <!-- CIJENA -->
                    <TextBlock Text="Cijena"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="PriceTextBox"
                             Height="40"
                             Padding="10,0"
                             FontSize="13"
                             IsReadOnly="True"
                             Background="#F5F3F6"
                             Margin="0,0,0,18"/>


                    <!-- STATUS -->
                    <TextBlock Text="Status"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <ComboBox x:Name="StatusComboBox"
                              Height="40"
                              Padding="10,0"
                              FontSize="13"
                              Margin="0,0,0,10"/>

                </StackPanel>

            </ScrollViewer>


            <!-- DUGMAD -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Otkaži"
                        Width="90"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="White"
                        Foreground="#777777"
                        BorderBrush="#E5DFE8"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelButton_Click"/>

                <Button Content="Sačuvaj"
                        Width="100"
                        Height="38"
                        Background="#9C27B0"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>