<Window x:Class="eTermin.Desktop.Windows.AddSalonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj salon"
        Width="620"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F6FA">

    <Border Margin="25"
            Background="White"
            CornerRadius="18"
            Padding="28">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- NASLOV -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,25">

                <TextBlock Text="Dodaj salon"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2F2635"/>

                <TextBlock Text="Unesite osnovne podatke o salonu."
                           FontSize="14"
                           Foreground="#817784"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <!-- FORMA -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- NAZIV -->

                    <TextBlock Text="Naziv salona"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="NameTextBox"
                             Height="40"
                             Padding="10"
                             ToolTip="Unesite naziv salona"
                             Margin="0,0,0,16"/>


                    <!-- OPIS -->

                    <TextBlock Text="Opis"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="DescriptionTextBox"
                             Height="75"
                             Padding="10"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Kratak opis salona"
                             Margin="0,0,0,16"/>


                    <!-- ADRESA -->

                    <TextBlock Text="Adresa"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="AddressTextBox"
                             Height="40"
                             Padding="10"
                             ToolTip="Npr. Zmaja od Bosne 15"
                             Margin="0,0,0,16"/>


                    <!-- GRAD -->

                    <TextBlock Text="Grad"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="CityTextBox"
                             Height="40"
                             Padding="10"
                             ToolTip="Unesite grad"
                             Margin="0,0,0,16"/>


                    <!-- TELEFON -->

                    <TextBlock Text="Telefon"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="PhoneNumberTextBox"
                             Height="40"
                             Padding="10"
                             ToolTip="Npr. 033 123 456"
                             Margin="0,0,0,16"/>


                    <!-- EMAIL -->

                    <TextBlock Text="Email"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="EmailTextBox"
                             Height="40"
                             Padding="10"
                             ToolTip="Npr. salon@email.com"
                             Margin="0,0,0,16"/>


                    <!-- SLIKA -->

                    <TextBlock Text="URL slike"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="ImageUrlTextBox"
                             Height="40"
                             Padding="10"
                             ToolTip="URL slike salona"
                             Margin="0,0,0,16"/>


                    <!-- AKTIVAN -->

                    <CheckBox x:Name="IsActiveCheckBox"
                              Content="Salon je aktivan"
                              IsChecked="True"
                              FontWeight="SemiBold"
                              Margin="0,0,0,10"/>

                </StackPanel>

            </ScrollViewer>


            <!-- DUGMAD -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Odustani"
                        Width="110"
                        Height="42"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button Content="Sačuvaj"
                        Width="110"
                        Height="42"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>