<Window x:Class="eTermin.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eTermin"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F7F4F8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>

        <!-- LIJEVA STRANA -->
        <Grid Grid.Column="0"
              Background="#9C27B0">

            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="380">

                <TextBlock
                    Text="eTermin"
                    Foreground="White"
                    FontSize="52"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Sistem za upravljanje terminima"
                    Foreground="#F3E5F5"
                    FontSize="18"
                    TextAlignment="Center"
                    Margin="0,15,0,0"/>

                <TextBlock
                    Text="Jednostavno upravljanje salonima, zaposlenicima, uslugama i terminima."
                    Foreground="#F3E5F5"
                    FontSize="14"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="30,25,30,0"/>

            </StackPanel>

        </Grid>


        <!-- DESNA STRANA -->
        <Grid Grid.Column="1"
              Background="White">

            <StackPanel
                Width="330"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

                <TextBlock
                    Text="Prijava"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="#29232D"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Prijavite se u eTermin"
                    FontSize="14"
                    Foreground="#777777"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,30"/>


                <!-- EMAIL -->
                <TextBlock
                    Text="Email"
                    FontWeight="SemiBold"
                    Margin="0,0,0,7"/>

                <TextBox
                    x:Name="EmailTextBox"
                    Height="42"
                    Padding="10"
                    FontSize="14"
                    Margin="0,0,0,18"/>


                <!-- PASSWORD -->
                <TextBlock
    Text="Lozinka"
    FontWeight="SemiBold"
    Margin="0,0,0,7"/>

                <Grid Height="42" Margin="0,0,0,25">

                    <!-- Skrivena lozinka -->
                    <PasswordBox
        x:Name="PasswordBox"
        Height="42"
        Padding="10,0,45,0"
        FontSize="14"
        VerticalContentAlignment="Center"/>

                    <!-- Vidljiva lozinka -->
                    <TextBox
        x:Name="VisiblePasswordTextBox"
        Height="42"
        Padding="10,0,45,0"
        FontSize="14"
        Visibility="Collapsed"
        VerticalContentAlignment="Center"/>

                    <!-- Eye dugme -->
                    <Button
        x:Name="PasswordVisibilityButton"
        Width="40"
        Height="40"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Background="Transparent"
        BorderThickness="0"
        FontSize="18"
        Content="👁"
        Cursor="Hand"
        Click="PasswordVisibilityButton_Click"/>

                </Grid>


                <!-- ERROR -->
                <TextBlock
                    x:Name="ErrorTextBlock"
                    Foreground="#D32F2F"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Margin="0,0,0,15"/>


                <!-- LOGIN BUTTON -->
                <Button
                    x:Name="LoginButton"
                    Content="Prijavi se"
                    Height="45"
                    Background="#9C27B0"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="LoginButton_Click"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>