<Window x:Class="eTermin.Desktop.Windows.EditSalonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uredi salon"
        Width="600"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F4F8">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                Text="Uredi salon"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#2D1B36"/>

            <TextBlock
                Text="Izmijenite podatke o salonu."
                FontSize="14"
                Foreground="#777777"
                Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Naziv salona"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="NameTextBox"
                         Height="50"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>


                <TextBlock Text="Opis"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="DescriptionTextBox"
                         Height="70"
                         Padding="12"
                         FontSize="14"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,15"/>


                <TextBlock Text="Adresa"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="AddressTextBox"
                         Height="50"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>


                <TextBlock Text="Grad"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="CityTextBox"
                         Height="40"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>


                <TextBlock Text="Broj telefona"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="PhoneTextBox"
                         Height="50"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>


                <TextBlock Text="Email"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="EmailTextBox"
                         Height="50"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>


                <TextBlock Text="Image URL"
                           FontSize="13"
                           Foreground="#555555"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="ImageUrlTextBox"
                         Height="50"
                         Padding="12"
                         FontSize="14"
                         Margin="0,0,0,15"/>


                <CheckBox x:Name="IsActiveCheckBox"
                          Content="Salon je aktivan"
                          FontSize="14"
                          Foreground="#444444"
                          Margin="0,0,0,10"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button
                Content="Otkaži"
                Width="100"
                Height="40"
                Margin="0,0,10,0"
                Background="White"
                Foreground="#555555"
                BorderBrush="#D8D0DB"
                BorderThickness="1"
                Cursor="Hand"
                Click="CancelButton_Click"/>

            <Button
                Content="Sačuvaj"
                Width="110"
                Height="40"
                Background="#9C27B0"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>
</Window>