<Window x:Class="eTermin.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Postavke - eTermin"
        Height="611"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F4F8">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock
                Text="Postavke"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#2D1B36"/>

            <TextBlock
                Text="Upravljajte postavkama eTermin aplikacije."
                FontSize="14"
                Foreground="#777777"
                Margin="0,6,0,0"/>

        </StackPanel>


        <!-- POSTAVKE MENI -->
        <!-- SADRŽAJ -->
        <Grid Grid.Row="1">

            <!-- GLAVNI MENI -->
            <Border x:Name="SettingsMenuPanel"
            Background="White"
            CornerRadius="12"
            Padding="20">

                <StackPanel>

                    <!-- MOJ PROFIL -->
                    <Button
                x:Name="ProfileSettingsButton"
                Height="85"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Left"
                Padding="10"
                Cursor="Hand"
                Click="ProfileSettingsButton_Click">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                        Grid.Column="0"
                        Text="👤"
                        FontSize="28"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

                            <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                <TextBlock
                            Text="Moj profil"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#2D1B36"/>

                                <TextBlock
                            Text="Osnovni podaci administratora"
                            FontSize="13"
                            Foreground="#777777"
                            Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                    <Border
                Height="1"
                Background="#EEEEEE"
                Margin="10,0"/>


                    <!-- SIGURNOST -->
                    <Button
                x:Name="SecuritySettingsButton"
                Height="85"
                Background="Transparent"
                BorderThickness="0"
                HorizontalContentAlignment="Left"
                Padding="10"
                Cursor="Hand"
                Click="SecuritySettingsButton_Click">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                        Grid.Column="0"
                        Text="🔒"
                        FontSize="27"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>

                            <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                <TextBlock
                            Text="Sigurnost"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="#2D1B36"/>

                                <TextBlock
                            Text="Promjena lozinke"
                            FontSize="13"
                            Foreground="#777777"
                            Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                    <Border
                Height="1"
                Background="#EEEEEE"
                Margin="10,0"/>


                   

                </StackPanel>

            </Border>


            <!-- SIGURNOST - PROMJENA LOZINKE -->
            <Border x:Name="SecurityPanel"
        Background="White"
        CornerRadius="12"
        Padding="25"
        Visibility="Collapsed">

                <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <Button
                Content="←  Nazad"
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                FontSize="14"
                Foreground="#777777"
                Cursor="Hand"
                Click="BackToSettings_Click"
                Padding="0"
                Margin="0,0,0,20"/>

                    <TextBlock
                Text="Sigurnost"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#2D1B36"
                Margin="0,0,0,5"/>

                    <TextBlock
                Text="Promijenite lozinku administratorskog računa."
                FontSize="13"
                Foreground="#777777"
                Margin="0,0,0,25"/>


                    <!-- TRENUTNA LOZINKA -->
                    <TextBlock
                Text="Trenutna lozinka"
                FontWeight="SemiBold"
                Margin="0,0,0,7"/>

                    <PasswordBox
                x:Name="CurrentPasswordBox"
                Height="40"
                Padding="10"
                FontSize="14"
                Margin="0,0,0,18"
                VerticalContentAlignment="Center"/>


                    <!-- NOVA LOZINKA -->
                    <TextBlock
                Text="Nova lozinka"
                FontWeight="SemiBold"
                Margin="0,0,0,7"/>

                    <PasswordBox
                x:Name="NewPasswordBox"
                Height="40"
                Padding="10"
                FontSize="14"
                Margin="0,0,0,18"
                VerticalContentAlignment="Center"/>


                    <!-- POTVRDA -->
                    <TextBlock
                Text="Potvrdi novu lozinku"
                FontWeight="SemiBold"
                Margin="0,0,0,7"/>

                    <PasswordBox
                x:Name="ConfirmPasswordBox"
                Height="40"
                Padding="10"
                FontSize="14"
                Margin="0,0,0,25"
                VerticalContentAlignment="Center"/>


                    <!-- PORUKA -->
                        <TextBlock
    x:Name="ErrorTextBlock"
    Foreground="#C62828"
    FontSize="13"
    TextWrapping="Wrap"
    Visibility="Collapsed"
    Margin="0,0,0,15"/>


                        <!-- DUGME -->
                    <Button
                x:Name="ChangePasswordButton"
                Content="Promijeni lozinku"
                Height="42"
                Background="#9C27B0"
                Foreground="White"
                FontSize="14"
                FontWeight="SemiBold"
                BorderThickness="0"
                Cursor="Hand"
                Click="ChangePasswordButton_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

           

            <!-- MOJ PROFIL -->
            <Border x:Name="ProfilePanel"
        Background="White"
        CornerRadius="12"
        Padding="25"
        Visibility="Collapsed">

                <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <Button
            Content="←  Nazad"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            FontSize="14"
            Foreground="#777777"
            Cursor="Hand"
            Click="BackToSettings_Click"
            Padding="0"
            Margin="0,0,0,20"/>

                    <TextBlock
            Text="Moj profil"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#2D1B36"
            Margin="0,0,0,5"/>

                    <TextBlock
            Text="Osnovni podaci administratora."
            FontSize="13"
            Foreground="#777777"
            Margin="0,0,0,25"/>


                    <!-- IME -->
                    <TextBlock
            Text="Ime"
            FontWeight="SemiBold"
            Margin="0,0,0,5"/>

                        <TextBox
    x:Name="FirstNameTextBox"
    Height="40"
    Padding="10"
    FontSize="14"
    Margin="0,0,0,18"
    VerticalContentAlignment="Center"/>


                        <!-- PREZIME -->
                    <TextBlock
            Text="Prezime"
            FontWeight="SemiBold"
            Margin="0,0,0,5"/>

                        <TextBox
    x:Name="LastNameTextBox"
    Height="40"
    Padding="10"
    FontSize="14"
    Margin="0,0,0,18"
    VerticalContentAlignment="Center"/>


                        <!-- EMAIL -->
                    <TextBlock
            Text="Email"
            FontWeight="SemiBold"
            Margin="0,0,0,5"/>

                        <TextBox
    x:Name="EmailTextBox"
    Height="40"
    Padding="10"
    FontSize="14"
    Margin="0,0,0,18"
    VerticalContentAlignment="Center"/>


                        <!-- ULOGA -->
                    <TextBlock
            Text="Uloga"
            FontWeight="SemiBold"
            Margin="0,0,0,5"/>

                    <TextBox
            x:Name="RoleTextBox"
            Height="40"
            Padding="10"
            FontSize="14"
            IsReadOnly="True"/>

                        <Button
    x:Name="SaveProfileButton"
    Content="Sačuvaj promjene"
    Height="42"
    Background="#9C27B0"
    Foreground="White"
    FontSize="14"
    FontWeight="SemiBold"
    BorderThickness="0"
    Cursor="Hand"
    Margin="0,25,0,0"
    Click="SaveProfileButton_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</Window>