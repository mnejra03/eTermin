<Window x:Class="eTermin.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Postavke - eTermin"
        Height="611"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F4F8">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock
                Text="Postavke"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#2D1B36"/>

            <TextBlock
                Text="Upravljajte postavkama eTermin aplikacije."
                FontSize="14"
                Foreground="#777777"
                Margin="0,6,0,0"/>

        </StackPanel>


        <!-- SADRŽAJ -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="25">

            <StackPanel>

                <TextBlock
                    Text="Sigurnost"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#2D1B36"
                    Margin="0,0,0,5"/>

                <TextBlock
                    Text="Promijenite lozinku administratorskog računa."
                    FontSize="13"
                    Foreground="#777777"
                    Margin="0,0,0,25"/>


                <!-- TRENUTNA LOZINKA -->
                <TextBlock
                    Text="Trenutna lozinka"
                    FontWeight="SemiBold"
                    Margin="0,0,0,7"/>

                <PasswordBox
                    x:Name="CurrentPasswordBox"
                    Height="40"
                    Padding="10"
                    FontSize="14"
                    Margin="0,0,0,18"
                    VerticalContentAlignment="Center"/>


                <!-- NOVA LOZINKA -->
                <TextBlock
                    Text="Nova lozinka"
                    FontWeight="SemiBold"
                    Margin="0,0,0,7"/>

                <PasswordBox
                    x:Name="NewPasswordBox"
                    Height="40"
                    Padding="10"
                    FontSize="14"
                    Margin="0,0,0,18"
                    VerticalContentAlignment="Center"/>


                <!-- POTVRDA -->
                <TextBlock
                    Text="Potvrdi novu lozinku"
                    FontWeight="SemiBold"
                    Margin="0,0,0,7"/>

                <PasswordBox
                    x:Name="ConfirmPasswordBox"
                    Height="40"
                    Padding="10"
                    FontSize="14"
                    Margin="0,0,0,25"
                    VerticalContentAlignment="Center"/>


                <!-- PORUKA -->
                <TextBlock
                    x:Name="ErrorTextBlock"
                    Foreground="#D32F2F"
                    TextWrapping="Wrap"
                    Visibility="Collapsed"
                    Margin="0,0,0,15"/>


                <!-- DUGME -->
                <Button
                    x:Name="ChangePasswordButton"
                    Content="Promijeni lozinku"
                    Height="42"
                    Background="#9C27B0"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ChangePasswordButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>