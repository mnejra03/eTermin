<Window x:Class="eTermin.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eTermin - Dashboard"
        Height="750"
        Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="#F7F4F8">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="85"/>
            <ColumnDefinition Width="907*"/>
            <ColumnDefinition Width="113*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR -->

        <Grid Grid.Column="0"
      Background="#3F214F"
      Width="85">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- GLAVNI DIO SIDEBARA -->
            <StackPanel Grid.Row="0"
                VerticalAlignment="Top">

                <!-- eTermin naziv -->
                <TextBlock Text="eTermin"
                   Foreground="White"
                   FontSize="17"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,28,0,130"/>


                <!-- Dashboard -->
                <Button Width="52"
        Height="52"
        Margin="0,0,0,18"
        Background="#9C27B0"
        BorderThickness="0"
        ToolTip="Dashboard"
        Cursor="Hand">

                    <TextBlock Text="&#xE80F;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="21"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>


                <!-- Saloni -->
                <Button Width="52"
        Height="52"
        Margin="0,0,0,18"
        Background="Transparent"
        BorderThickness="0"
        ToolTip="Saloni"
        Cursor="Hand">

                    <TextBlock Text="&#xE7F1;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="21"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>


                <!-- Zaposlenici -->
                <Button Width="52"
        Height="52"
        Margin="0,0,0,18"
        Background="Transparent"
        BorderThickness="0"
        ToolTip="Zaposlenici"
        Cursor="Hand">

                    <TextBlock Text="&#xE716;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="21"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>


                <!-- Usluge -->
                <Button Width="52"
        Height="52"
        Margin="0,0,0,18"
        Background="Transparent"
        BorderThickness="0"
        ToolTip="Usluge"
        Cursor="Hand">

                    <TextBlock Text="&#xE90F;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="21"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>


                <!-- Termini -->
                <Button Width="52"
        Height="52"
        Margin="0,0,0,18"
        Background="Transparent"
        BorderThickness="0"
        ToolTip="Termini"
        Cursor="Hand">

                    <TextBlock Text="&#xE787;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="21"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>


                <!-- Statistika -->
                <Button Width="52"
        Height="52"
        Margin="0,0,0,18"
        Background="Transparent"
        BorderThickness="0"
        ToolTip="Statistika"
        Cursor="Hand">

                    <TextBlock Text="&#xE9D2;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="21"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </Button>

            </StackPanel>


            <!-- DONJI DIO -->
            <StackPanel Grid.Row="1"
            Margin="0,0,0,10">

                <!-- Settings -->
                <Button x:Name="SettingsButton"
        Width="52"
        Height="52"
        Background="Transparent"
        BorderThickness="0"
        ToolTip="Postavke"
        Cursor="Hand"
        Click="SettingsButton_Click">

                    <TextBlock Text="&#xE713;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="21"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                </Button>

            </StackPanel>

            <!-- SETTINGS POPUP -->
            <Popup x:Name="SettingsPopup"
       Placement="Top"
       PlacementTarget="{Binding ElementName=SettingsButton}"
       StaysOpen="False"
       AllowsTransparency="True"
       PopupAnimation="Fade">

                <Border Background="White"
            Width="180"
            Padding="8"
            CornerRadius="10"
            BorderBrush="#E0E0E0"
            BorderThickness="1">

                    <StackPanel>

                        <!-- Postavke -->
                        <Button Height="42"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    Padding="10,0"
                    Cursor="Hand">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#3F214F"
                               VerticalAlignment="Center"/>

                                <TextBlock Text="Postavke"
                               FontSize="13"
                               Foreground="#333333"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- Odjava -->
                        <Button Height="42"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalContentAlignment="Left"
                    Padding="10,0"
                    Cursor="Hand"
                    Click="LogoutButton_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="&#xE8AC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#3F214F"
                               VerticalAlignment="Center"/>

                                <TextBlock Text="Odjava"
                               FontSize="13"
                               Foreground="#333333"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>

                </Border>

            </Popup>


        </Grid>


        <!-- MAIN CONTENT -->

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">

            <StackPanel Margin="35">


                <!-- HEADER -->

                <Grid Margin="0,0,0,30">

                    <!-- POZDRAV -->
                    <StackPanel HorizontalAlignment="Left"
                VerticalAlignment="Center">

                        <TextBlock x:Name="GreetingText"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#2D1B36"/>

                        <TextBlock Text="Dobro došli nazad u eTermin."
                   FontSize="14"
                   Foreground="#777777"
                   Margin="0,8,0,0"/>

                        <TextBlock Text="Pregledajte današnje termine i aktivnosti vaših salona."
                   FontSize="13"
                   Foreground="#999999"
                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- FILTER SALONA -->
                    <ComboBox x:Name="SalonFilterComboBox"
              Width="185"
              Height="42"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              FontSize="13"
              Foreground="#333333"
              Background="White"
              BorderBrush="#EEEEEE"
              BorderThickness="1"
              Padding="14,0"
              HorizontalContentAlignment="Left"
              VerticalContentAlignment="Center"
              SelectionChanged="SalonFilterComboBox_SelectionChanged" Margin="0,33,0,0">

                        <ComboBox.Resources>

                            <Style TargetType="ComboBoxItem">

                                <Setter Property="Height"
                        Value="38"/>

                                <Setter Property="Padding"
                        Value="12,0"/>

                                <Setter Property="FontSize"
                        Value="13"/>

                                <Setter Property="Foreground"
                        Value="#333333"/>

                                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>

                                <Setter Property="Background"
                        Value="White"/>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver"
                             Value="True">

                                        <Setter Property="Background"
                                Value="#F4EEFF"/>

                                        <Setter Property="Foreground"
                                Value="#7C5CFC"/>

                                    </Trigger>

                                    <Trigger Property="IsSelected"
                             Value="True">

                                        <Setter Property="Background"
                                Value="#F4EEFF"/>

                                        <Setter Property="Foreground"
                                Value="#7C5CFC"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </ComboBox.Resources>

                    </ComboBox>

                </Grid>


                <!-- STATISTICS CARDS -->

                <UniformGrid Columns="4"
                             Margin="0,0,0,25">


                    <!-- APPOINTMENTS -->

                    <Border
                        Background="White"
                        CornerRadius="12"
                        Margin="0,0,12,0"
                        Padding="20">

                        <StackPanel>
                            <TextBlock Text="&#xE787;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="24"
                   Foreground="#9C27B0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="79*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TotalAppointmentsText"
                   Text="0"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#9C27B0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top" Height="38" Margin="102,-13,0,0" Width="18"/>




                            </Grid>
                            <TextBlock
                                Text="Ukupno termina danas"
                                Foreground="#888888"
                                FontSize="16"/>
                        </StackPanel>

                    </Border>


                    <!-- USERS -->

                    <Border
     Background="White"
     CornerRadius="12"
     Margin="0,0,12,0"
     Padding="20">

                        <StackPanel>
                            <TextBlock Text="&#xE716;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="24"
                   Foreground="#9C27B0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="79*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TotalUsersText"
Text="0"
FontSize="28"
FontWeight="Bold"
Foreground="#9C27B0"
HorizontalAlignment="Left"
VerticalAlignment="Top" Height="38" Margin="102,-13,0,0" Width="18"/>




                            </Grid>
                            <TextBlock
             Text="Ukupno korisnika "
             Foreground="#888888"
             FontSize="16"/>
                        </StackPanel>

                    </Border>


                    <!-- SALONS -->

                    <Border
     Background="White"
     CornerRadius="12"
     Margin="0,0,12,0"
     Padding="20">

                        <StackPanel>
                            <TextBlock Text="&#xE7F1;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="24"
                   Foreground="#9C27B0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="79*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TotalSalonsText"
Text="0"
FontSize="28"
FontWeight="Bold"
Foreground="#9C27B0"
HorizontalAlignment="Left"
VerticalAlignment="Top" Height="38" Margin="102,-13,0,0" Width="18"/>




                            </Grid>
                            <TextBlock
             Text="Broj salona "
             Foreground="#888888"
             FontSize="16"/>
                        </StackPanel>

                    </Border>


                    <!-- REVENUE -->

                    <Border
     Background="White"
     CornerRadius="12"
     Margin="0,0,12,0"
     Padding="20">

                        <StackPanel>
                            <TextBlock Text="&#xE8C8;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="24"
                   Foreground="#9C27B0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="134*"/>
                                    <ColumnDefinition Width="9*"/>
                                    <ColumnDefinition Width="79*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="TotalRevenueText"
Text="0"
FontSize="28"
FontWeight="Bold"
Foreground="#9C27B0"
HorizontalAlignment="Left"
VerticalAlignment="Top" Height="38" Margin="102,-13,0,0" Width="18"/>




                            </Grid>
                            <TextBlock
             Text="Prihod (KM)"
             Foreground="#888888"
             FontSize="16"/>
                        </StackPanel>

                    </Border>

                </UniformGrid>


                <!-- LOWER AREA -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>


                    <!-- TODAY APPOINTMENTS -->

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,0,15,0">

                        <StackPanel>

                            <TextBlock
                                Text="Današnji termini"
                                FontSize="20"
                                FontWeight="Bold"
                                Margin="0,0,0,20"/>

                            <ItemsControl x:Name="TodayAppointmentsItemsControl">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border
                Background="#F7F4F8"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>


                                                <StackPanel>

                                                    <TextBlock
        Text="{Binding UserName}"
        FontWeight="SemiBold"/>

                                                    <TextBlock
        Text="{Binding ServiceName}"
        Foreground="#777777"
        FontSize="12"
        Margin="0,5,0,0"/>

                                                    <TextBlock
        Text="{Binding SalonName}"
        Foreground="#777777"
        FontSize="12"
        Margin="0,3,0,0"/>

                                                    <TextBlock
        Text="{Binding Status}"
        Foreground="#777777"
        FontSize="12"
        Margin="0,3,0,0"/>

                                                </StackPanel>


                                                <StackPanel Grid.Column="1">

                                                    <TextBlock
        Text="{Binding StartTime, StringFormat={}{0:HH:mm}}"
        FontWeight="Bold"
        Foreground="#9C27B0"/>

                                                    <TextBlock
        Text="{Binding Price, StringFormat={}{0:0.00} KM}"
        FontSize="11"
        Foreground="#777777"
        HorizontalAlignment="Right"/>

                                                </StackPanel>


                                            </Grid>

                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>


                        </StackPanel>

                    </Border>


                    <!-- POPULAR SERVICE -->

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="25">

                        <StackPanel>

                            <TextBlock
                                Text="Najpopularnija usluga"
                                FontSize="20"
                                FontWeight="Bold"/>

                            <TextBlock
    x:Name="MostPopularServiceText"
    Text="-"
    FontSize="28"
                                FontWeight="Bold"
                                Foreground="#9C27B0"
                                Margin="0,25,0,5"/>

                            <TextBlock
    x:Name="MostPopularServiceCountText"
    Text="0 rezervacija"
    Foreground="#777777"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>